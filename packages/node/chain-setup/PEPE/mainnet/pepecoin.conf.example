dbcache=4000
txindex=1
printtoconsole=1

# [rpc]
# Accept command line and JSON-RPC commands.
server=1
# Username for JSON-RPC connections
# Generate with: python3 scripts/rpc-auth.py bcn-admin, and put the password in .env
rpcauth=
rpcallowip=0.0.0.0/0
rpcbind=0.0.0.0
# Rpc work queue increase
rpcworkqueue=512
rpcport=33873
port=33874

relaypriority=false
prematurewitness=1

# [wallet]
wallet=defaultwallet

printtoconsole=1

zmqpubhashtx=tcp://0.0.0.0:28332
zmqpubrawtx=tcp://0.0.0.0:28332
zmqpubsequence=tcp://0.0.0.0:28332

