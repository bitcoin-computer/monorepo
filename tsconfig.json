{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "lib": ["esnext", "DOM"],
    "noEmit": true
  },
  "exclude": ["node_modules", "**/*.spec.ts"]
}
